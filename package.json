{
  "name": "maihoc-learning-system",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "build": "node scripts/build.mjs",
    "check:dist": "node scripts/build.mjs --check",
    "test:platform": "node --test server/platform/*.test.js",
    "db:plan": "node server/platform/migrate.js",
    "db:migrate": "node server/platform/migrate.js --apply",
    "db:bootstrap": "node server/platform/bootstrap.js",
    "jobs:worker": "node server/platform/worker.js",
    "db:legacy": "node scripts/legacy-maintenance.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "preview:isolated": "node scripts/dev-preview.mjs",
    "storage:verify": "node server/platform/verify-storage.js",
    "test:learning": "node scripts/learning-check.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@playwright/test": "^1.51.1",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10"
  }
}
