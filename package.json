{
  "name": "maihoc-learning-system",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "build": "node scripts/build.mjs",
    "check:dist": "node scripts/build.mjs --check",
    "test:account-upgrade": "node scripts/account-upgrade-check.mjs && node scripts/admin-school-grants-check.mjs",
    "test:school-mail": "node scripts/school-mail-check.mjs",
    "test:school-access": "node scripts/school-access-check.mjs",
    "test:platform": "node --test server/platform/*.test.js",
    "db:plan": "node server/platform/migrate.js",
    "db:migrate": "node server/platform/migrate.js --apply",
    "db:bootstrap": "node server/platform/bootstrap.js",
    "jobs:worker": "node server/platform/worker.js",
    "db:legacy": "node scripts/legacy-maintenance.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "preview:isolated": "node scripts/dev-preview.mjs",
    "storage:verify": "node server/platform/verify-storage.js",
    "test:learning": "node scripts/learning-check.mjs",
    "test:advisor": "node scripts/learning-advisor-check.mjs",
    "test:auth": "node scripts/auth-check.mjs",
    "mail:check": "node server/check-mail.js",
    "ai:check": "node server/check-ai.js",
    "school:worker": "node server/school-upgrade/worker.js",
    "test:school-upgrade": "node --test server/school-upgrade/*.test.js",
    "test:school-upgrade:browser": "node scripts/school-upgrade-check.mjs",
    "test:learning-welcome": "node scripts/learning-welcome-check.mjs",
    "test:school-theme": "node scripts/school-theme-check.mjs",
    "test:school-management-options": "node scripts/removed-school-modules-check.mjs",
    "test:billing": "node --test server/billing.test.js",
    "test:sepay-proxy": "node --test workers/sepay-webhook-proxy/worker.test.js"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@playwright/test": "^1.51.1",
    "esbuild": "^0.28.2",
    "exceljs": "^4.4.0",
    "prettier": "^3.9.10"
  },
  "dependencies": {
    "katex": "^0.19.1",
    "livekit-client": "2.23.0",
    "pdfkit": "^0.20.2",
    "three": "0.187.0"
  }
}
