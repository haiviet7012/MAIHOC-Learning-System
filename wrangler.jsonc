{
  "name": "maihoc-learning",
  "main": "./worker.js",
  "compatibility_date": "2026-10-28",
  "vars": {
    "BACKEND_ORIGIN": "https://maihoc-learning-system.onrender.com"
  },
  "previews": {
    "vars": {
      // Keep PR previews isolated from the production backend.
      // Set this to a dedicated staging backend URL to enable API testing.
      "BACKEND_ORIGIN": ""
    }
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/socket.io/*"
    ]
  }
}