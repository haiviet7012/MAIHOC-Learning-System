{
  "name": "maihoc-learning-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "check:postgres": "node ./check-postgres.js",
    "migrate:postgres": "node ./migrate-sqlite-to-postgres.js",
    "test:cleanup": "node --test ./tests/k6-cleanup.test.js",
    "test:postgres-import": "node --test ./tests/migrate-sqlite-to-postgres.test.js",
    "test:postgres-runtime": "node --test ./tests/postgres-runtime.test.js",
    "inspect:postgres-cutover": "node ./inspect-postgres-cutover.js",
    "test:postgres-cutover-report": "node --test ./tests/postgres-cutover-report.test.js",
    "cleanup:personal-history": "node ./scripts/cleanup-personal-history.js",
    "test:personal-history-cleanup": "node --test ./tests/personal-history-cleanup.test.js",
    "check:postgres-auth": "node ./check-postgres-auth.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1159.0",
    "@google/generative-ai": "^0.24.1",
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "maihoc-learning-system": "file:..",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.10.1",
    "pdfjs-dist": "6.4.299",
    "pg": "^8.23.1",
    "socket.io": "^4.8.4",
    "sqlite3": "^6.0.1"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true
  }
}
