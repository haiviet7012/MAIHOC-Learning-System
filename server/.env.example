# Copy to server/.env. Never commit server/.env or share these values.
PORT=3000

# PostgreSQL connection string (Required so user accounts, sessions, tests, and grading persist across Render redeploys).
# Use Internal Database URL on Render web service, or External Database URL (?sslmode=require) when connecting from local machine.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Optional: set DATABASE_SSL=true for cloud Postgres providers that require TLS without sslmode in URL.
# DATABASE_SSL=true

# Gemini model for the shared AI homework solver. Set the same value in Render Environment.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# GOOGLE_API_KEY is accepted when GEMINI_API_KEY is blank. Keep only the intended key.
# Copy the full key from Google AI Studio; both standard and authorization keys work.
# Render Environment values take precedence over local .env files.
GEMINI_MODEL=
# Separate key for exam solving/answer generation; blank uses the shared key.
GEMINI_SOLUTION_API_KEY=
# Set a verified model identifier for your provider account.
GEMINI_SOLUTION_MODEL=

# Optional: creates the first Admin account when the database has no matching email.
# Use a strong unique password of at least 12 characters.
ADMIN_NAME=MAI HOC Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Set to your site origin in production, e.g. https://maihoc.example.com
# PUBLIC_ORIGIN=http://localhost:3000

# SMTP settings for email alerts when a User submits a document.
# Use an app password with your email provider; do not commit real credentials.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail-address@gmail.com
# Use a Google App Password (16 characters), not your regular Gmail password.
SMTP_PASS=your-16-character-app-password
SMTP_FROM=your-gmail-address@gmail.com
# ADMIN_EMAIL above receives document review emails.
# Password-reset verification defaults to these SMTP settings.
# For hosts blocking SMTP (including Render Free), use HTTPS mail delivery instead:
# MAIL_PROVIDER=resend
# RESEND_API_KEY=              # private API key; configure in backend environment only
# MAIL_FROM=MAIHOC <no-reply@your-verified-domain.com>
# MAIL_FROM must use a sender/domain verified with Resend; Gmail SMTP credentials are not API keys.
# Leave MAIL_PROVIDER unset to auto-select Resend when RESEND_API_KEY exists, otherwise SMTP.

# Cloudflare Realtime TURN — never expose these credentials in browser code.
CLOUDFLARE_TURN_KEY_ID=YOUR_CLOUDFLARE_TURN_KEY_ID
CLOUDFLARE_TURN_API_TOKEN=YOUR_CLOUDFLARE_TURN_KEY_API_TOKEN

# Cloudflare R2: configure actual values only in server/.env or backend environment settings.
R2_ACCOUNT_ID=YOUR_R2_ACCOUNT_ID
R2_BUCKET_NAME=YOUR_R2_BUCKET_NAME
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY

# School/Learning upgrade: migrate on staging before enabling these flags.
MAIHOC_PLATFORM_ENABLED=0
MAIHOC_AI_WORKER_ENABLED=0
MAIHOC_PERSIST_STUDY_ROOMS=0
MAIHOC_R2_ONLY=0
MAIHOC_RUN_LEGACY_STARTUP_MIGRATIONS=0
MAIHOC_REBUILD_RESULTS_ON_EXPORT=0
# Use names verified with your provider account. Do not paste API keys into frontend.
GEMINI_FALLBACK_MODELS=
# MAIHOC_BACKUP_VERIFIED=1 only after an actual restore rehearsal.
