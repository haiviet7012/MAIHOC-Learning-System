# Copy to server/.env. Never commit server/.env or share these values.
PORT=3000
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash

# Optional: creates the first Admin account when the database has no matching email.
# Use a strong unique password of at least 12 characters.
ADMIN_NAME=MAI HOC Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Set to your site origin in production, e.g. https://maihoc.example.com
# PUBLIC_ORIGIN=http://localhost:3000

# SMTP settings for email alerts when a User submits a document.
# Use an app password with your email provider; do not commit real credentials.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# ADMIN_EMAIL above receives document review emails.
